# container-host as-built pins (Ubuntu 24.04 arm64 production VM, verified 2026-09-13).
# These are the reviewed as-built pins for the Ubuntu 24.04 arm64 production VM
# and must stay in sync with `docs/operations/container-host-provisioning.md`.
# Sourced shell file (`KEY=value` only, no side effects). Do not add commands here.
DOCKER_ARCH=arm64
DOCKER_SUITE=noble
DOCKER_CE_VERSION=5:29.8.0-1~ubuntu.24.04~noble
DOCKER_CE_CLI_VERSION=5:29.8.0-1~ubuntu.24.04~noble
DOCKER_CE_ROOTLESS_EXTRAS_VERSION=5:29.8.0-1~ubuntu.24.04~noble
CONTAINERD_IO_VERSION=2.3.5-1~ubuntu.24.04~noble
DOCKER_BUILDX_PLUGIN_VERSION=0.37.1-1~ubuntu.24.04~noble
DOCKER_COMPOSE_PLUGIN_VERSION=5.5.1-1~ubuntu.24.04~noble
DOCKER_KEYRING=/etc/apt/keyrings/docker.asc
DOCKER_KEY_FINGERPRINTS=9DC858229FC7DD38854AE2D88D81803C0EBFCD88,D3306A018370199E527AE7997EA0A9C3F273FCD8
DOCKER_SOURCES=/etc/apt/sources.list.d/docker.sources
DOCKER_DAEMON_JSON=/etc/docker/daemon.json
GVISOR_RELEASE=20260907.0
GVISOR_PLATFORM=systrap
GVISOR_KEYRING=/usr/share/keyrings/gvisor-archive-keyring.gpg
GVISOR_KEY_FINGERPRINT=6F1DF85E3A71C24918E727D56FC6D554E32BD943
GVISOR_LIST=/etc/apt/sources.list.d/gvisor.list
GVISOR_APT_URL=https://storage.googleapis.com/gvisor/releases
GVISOR_ARCHIVE_KEY_URL=https://gvisor.dev/archive.key
RUNSC_BIN=/usr/bin/runsc
DOCKER_UBUNTU_URL=https://download.docker.com/linux/ubuntu
