{
  "name": "@docich/tsuitate-bot-worker",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "play:beta": "node scripts/play-beta.mjs",
    "train:brain": "node scripts/train-brain.mjs",
    "postinstall": "node scripts/patch-cf-self-binding.mjs",
    "prebuild:cf": "node scripts/patch-cf-self-binding.mjs",
    "test": "node --test test/*.test.js",
    "test:workerd": "node test/workerd-integration.mjs",
    "test:bundle": "node test/bundle-integration.mjs",
    "test:beta-workerd": "node test/beta-workerd-integration.mjs",
    "dev:cf": "cf dev --local --persist-to .wrangler/cf-local",
    "build:cf": "cf build && npm test && npm run test:workerd && npm run test:bundle"
  },
  "dependencies": {
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@cloudflare/build-output-utils": "0.8.5",
    "cf": "1.0.0-beta.12",
    "miniflare": "5.20261019.1-beta",
    "wrangler": "4.151.3"
  },
  "overrides": {
    "miniflare@5.20260930.0-alpha": {
      "sharp": "0.35.5"
    },
    "miniflare@5.20261001.0-alpha": {
      "sharp": "0.35.5"
    }
  }
}
