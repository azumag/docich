#!/usr/bin/env bash
# docich comment game-profile launcher.
#
# Prints the game-owned replacements for the live comment prompt as one JSON
# object (persona sentence, game state, UI memo, operational memo lines) while
# `<game>` owns the main screen, and prints nothing for a game docich has no
# profile for. The live chat worker calls it from the Soren root, so neither the
# caller's cwd (-P: never prepend it to sys.path) nor its PYTHONPATH may shadow
# the package. Callers must treat any failure or empty output as "no profile".
# Usage: docich-comment-profile <game>
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"
export PYTHONPATH="$ROOT/src"
exec python3 -P -m docich.comment.game_profile "$@"
