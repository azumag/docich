#!/usr/bin/env bash
# Default-off News PAPER research lane (parent #769 / N07).
# The worker is inert unless config/news-paper.toml enables it explicitly.
set -euo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
python_bin="$ROOT/.venv-trading/bin/python3"
if [[ ! -x "$python_bin" ]]; then python_bin=python3; fi

usage() {
  echo "usage: docich-news-paper {worker|status|dashboard} --config PATH" >&2
  exit 2
}

if [[ $# -eq 0 ]]; then usage; fi
command_name="$1"
shift
case "$command_name" in
  worker)    exec "$python_bin" -m docich.trading.news_paper.worker "$@" ;;
  status)    exec "$python_bin" -m docich.trading.news_paper.status "$@" ;;
  dashboard) exec "$python_bin" -m docich.trading.news_paper.dashboard "$@" ;;
  *)         usage ;;
esac
