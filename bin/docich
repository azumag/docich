#!/usr/bin/env bash
# docich 起動ランチャ: スクリプト自身の場所からリポジトリルートを解決し、
# src/ を PYTHONPATH に通してパッケージを実行する。
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"

export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"

# PAPER worker has optional market-data dependencies installed in its dedicated
# virtualenv.  A recovery may invoke `docich up` from a shell whose PATH does
# not contain that virtualenv; the tmux child must still start with the same
# interpreter as the canonical paper-runtime service.  Keep every other
# command on the caller's normal python3, and fail open to it in development
# checkouts where the trading virtualenv is intentionally absent.
args=("$@")
command_index=0
if (( ${#args[@]} >= 2 )) && [[ "${args[0]}" == "--config" ]]; then
    command_index=2
elif (( ${#args[@]} >= 1 )) && [[ "${args[0]}" == --config=* ]]; then
    command_index=1
fi
if (( command_index + 1 < ${#args[@]} )) \
    && [[ "${args[command_index]}" == "run" ]] \
    && [[ "${args[command_index + 1]}" == "trading" ]]; then
    trading_python="$ROOT/.venv-trading/bin/python3"
    if [[ -x "$trading_python" ]]; then
        exec "$trading_python" -m docich "$@"
    fi
fi

exec python3 -m docich "$@"
