#!/usr/bin/env bash
# docich 起動ランチャ: スクリプト自身の場所からリポジトリルートを解決し、
# src/ を PYTHONPATH に通してパッケージを実行する。
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"

export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"

# PAPER/trading commands share optional market-data/runtime dependencies that
# live in the dedicated trading virtualenv. Keep the whole PAPER lifecycle and
# isolated free-strategy research entrypoints on one interpreter. Selecting the
# interpreter never enables either worker. Unrelated commands stay on the
# caller's normal python3, with a development fallback when the venv is absent.
args=("$@")
command_index=0
if (( ${#args[@]} >= 2 )) && [[ "${args[0]}" == "--config" ]]; then
    command_index=2
elif (( ${#args[@]} >= 1 )) && [[ "${args[0]}" == --config=* ]]; then
    command_index=1
fi

use_trading_python=0
if (( command_index < ${#args[@]} )); then
    command="${args[command_index]}"
    if [[ "$command" == "trading" \
        || "$command" == "paper-corner" \
        || "$command" == "free-strategy" \
        || "$command" == "free-strategy-worker" ]]; then
        use_trading_python=1
    elif (( command_index + 1 < ${#args[@]} )) \
        && [[ "$command" == "run" ]] \
        && [[ "${args[command_index + 1]}" == "trading" ]]; then
        use_trading_python=1
    fi
fi

if (( use_trading_python )); then
    trading_python="$ROOT/.venv-trading/bin/python3"
    if [[ -x "$trading_python" ]]; then
        exec "$trading_python" -m docich "$@"
    fi
fi

exec python3 -m docich "$@"
