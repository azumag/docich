#!/usr/bin/env bash
# Stable launcher for the native RADIO consumer bridge (#1767 / #829).
#
# Reads one bounded JSON request from stdin and writes one JSON result to stdout.
# Credentials remain inherited environment only; topic/query text never appears
# in argv.
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"
export PYTHONPATH="$ROOT/src"
exec python3 -P -m docich.radio.consumer
