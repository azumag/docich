diff --git a/tests/test_flyhome_windows_control.py b/tests/test_flyhome_windows_control.py
index b0e01bb..8a2034d 100644
--- a/tests/test_flyhome_windows_control.py
+++ b/tests/test_flyhome_windows_control.py
@@ -472,3 +472,48 @@ def test_actual_level33_open_descent_does_not_require_two_spike_columns():
         ctl._precision_action(49.924, 33.337, -.588, -2.023, 0, .391)
         assert ctl._descent_commit is None
         assert ctl._precision_debug[7]
+
+
+def test_actual_level35_takeoff_near_spikes_uses_precision_before_near_home():
+    from docich.flyhome.tracker import State, PLAYING
+    ctl = _actual_mpc()
+    ctl.cfg.takeoff_s = 0
+    ctl._attempt = 1
+    ctl._ref = [(118, 26, 8, 0)] * ctl.cfg.horizon
+    ctl._make_ref = lambda x, y: None
+    ctl.hazards = [(131, 39 + 16*k, 141, 49 + 16*k) for k in range(8)]
+    ctl.hazards += [(163, 39 + 16*k, 173, 49 + 16*k) for k in range(8)]
+    assert not ctl._narrow_level
+    called = []
+    ctl._estimate = lambda st: (st.x, st.y, 0, -21.383, st.angle, 1.094)
+    ctl._precision_action = lambda *args: called.append(args) or 2
+    # 判定だけを検証し、先読みの運動モデルは実行しない。
+    ctl._policy_seq = lambda *args: (_ for _ in ()).throw(AssertionError('open MPC was used'))
+    st = State(10, PLAYING, 1, 103.924, 24.337, angle=0, home=(152, 154.6))
+    assert ctl.decide(st, st.home) == (False, True)
+    assert len(called) == 1
+
+
+def test_actual_level35_upper_reserve_allows_braking_before_sideways_landing():
+    ctl = _actual_mpc()
+    ctl._hist.append((10, 136.12, 23.293, -.196))
+    ctl._ref = [(138, 22, 8, -7.435)] * ctl.cfg.horizon
+    assert ctl._precision_action(136.12, 23.293, 8.9, -7.767, -.196, -1.001) == 1
+    # 上端の安全余裕が尽きる場合や、上に棘がある場合は噴射しない。
+    ctl._hist.clear()
+    ctl._hist.append((10, 136.12, 14.5, -.196))
+    assert ctl._precision_action(136.12, 14.5, 8.9, -7.767, -.196, -1.001) == 0
+    ctl._hist.clear()
+    ctl._hist.append((10, 136.12, 23.293, -.196))
+    ctl.hazards = [(131, 10, 141, 20)]
+    assert ctl._precision_action(136.12, 23.293, 8.9, -7.767, -.196, -1.001) == 0
+
+
+def test_vertical_descent_preserves_three_identical_position_observations():
+    ctl = _actual_mpc()
+    ctl._hist.extend([(9.88, 151, 60, 0), (9.92, 150, 60, 0),
+                      (9.96, 150, 60, 0), (10, 150, 60, 0)])
+    ctl._ref = [(150, 65, 0, 12)] * ctl.cfg.horizon
+    assert ctl._precision_action(150, 60, 0, 0, 0, 0) == 0
+    assert ctl._precision_debug[0] == 0
+    assert ctl._precision_debug[4] == 0
