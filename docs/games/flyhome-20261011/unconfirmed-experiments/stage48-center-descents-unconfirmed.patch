+def center_descending_passages(g: Grid, path: list[tuple[float, float]], hazards) -> list[tuple[float, float]]:
+    """Balance raw side clearance on long descents, only if all changed grid segments are free."""
+    out = list(path)
+    k = 0
+    while k < len(out) - 1:
+        sx, sy = out[k]
+        j = k
+        while j + 1 < len(out) and abs(out[j + 1][0] - sx) < 0.1 and out[j + 1][1] > out[j][1]:
+            j += 1
+        if j > k and out[j][1] - sy >= 24:
+            walls = [h for h in hazards if h[1] < out[j][1] + 10 and h[3] > sy - 10]
+            left = [h[2] for h in walls if h[2] <= sx]
+            right = [h[0] for h in walls if h[0] >= sx]
+            if left and right:
+                lo, hi = max(left), min(right)
+                mid = (lo + hi) * 0.5
+                if 16 <= hi - lo <= 40 and abs(mid - sx) <= 8:
+                    candidate = [(mid, out[i][1]) for i in range(k, j + 1)]
+                    check = ([out[k - 1]] if k else []) + candidate + ([out[j + 1]] if j + 1 < len(out) else [])
+                    if all(g.free(*g.to_cell(x, y)) for x, y in candidate) and not path_blocked(g, check):
+                        out[k:j + 1] = candidate
+        k = max(k + 1, j)
+    return out
