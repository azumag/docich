diff --git a/tests/test_flyhome_windows_control.py b/tests/test_flyhome_windows_control.py
index 3e4f4b0..0b77abc 100644
--- a/tests/test_flyhome_windows_control.py
+++ b/tests/test_flyhome_windows_control.py
@@ -482,3 +482,71 @@ def test_vertical_descent_preserves_three_identical_position_observations():
     assert ctl._precision_action(150, 60, 0, 0, 0, 0) == 0
     assert ctl._precision_debug[0] == 0
     assert ctl._precision_debug[4] == 0
+
+
+def test_actual_level35_descent_alignment_survives_path_entry_quantization():
+    ctl = _actual_mpc()
+    ctl.path = [(138, 22), (142, 22), (146, 22), (150, 22), (150, 26), (150, 134)]
+    ctl.hazards = [(131, 39, 141, 129), (163, 39, 173, 129)]
+    ctl._ref = [(150, 30, 0, 12)] * 14
+    ctl._hist.extend([(9.8,144.728,25.337,.206),(10,144.728,25.337,.206)])
+    ctl._precision_action(144.728,25.337,6.126,6.878,.206,-.466)
+    assert ctl._descent_commit is None
+    assert ctl._precision_debug[7]  # still align before entering, despite sy=22/y=25.337
+    assert ctl._precision_debug[3] == -1.07
+    ctl._precision_action(144.728,35,6.126,6.878,.206,-.466)
+    assert not ctl._precision_debug[7]  # below the entry band: continue shaft traversal
+
+
+def test_actual_level35_top_departure_brakes_pending_rotation_before_landing():
+    ctl = _actual_mpc()
+    ctl.hazards = [(131,39,141,129),(163,39,173,129)]
+    ctl._pending = [(.12,1)]
+    # Actual early departure x103.745/y22.309, angle .177, omega1.068.
+    assert ctl._guard_top_turn(103.745,22.309,.177,1.068,3) == 2
+    assert ctl._top_turn_debug[3] > .4
+    assert ctl._guard_top_turn(103.745,60,.177,1.068,3) == 3
+    ctl.hazards = []
+    assert ctl._guard_top_turn(103.745,22.309,.177,1.068,3) == 3
+    ctl.hazards = [(131,39,141,129)]
+    ctl._pending = [(.12,2)]
+    assert ctl._guard_top_turn(103.745,22.309,-.177,-1.068,3) == 1
+    ctl._pending = [(.12,0)]
+    assert ctl._guard_top_turn(103.745,22.309,.1,.1,3) == 3
+
+
+def test_actual_level35_descent_centre_uses_spike_gap_across_grid_replans():
+    ctl = _actual_mpc()
+    ctl.hazards = [(131,39,141,129),(163,39,173,129)]
+    ctl._ref = [(152,40,0,12)] * 14
+    ctl._hist.extend([(9.8,152,26,0),(10,152,26,0)])
+    for grid_x in (150,153):
+        ctl.path = [(grid_x,26),(grid_x,134)]
+        ctl._descent_ready_since = 9.5
+        ctl._descent_commit = None
+        ctl._precision_action(152,26,0,0,0,0)
+        assert ctl._descent_commit == (152,38)
+
+
+def test_descent_entry_small_centre_error_is_not_inside_angular_deadband():
+    ctl = _actual_mpc()
+    ctl.height = 180
+    ctl.path = [(150,26),(150,134)]
+    ctl.hazards = [(131,39,141,129),(163,39,173,129)]
+    ctl._ref = [(150,40,0,12)] * 14
+    ctl._hist.extend([(9.8,149,26,0),(10,149,26,0)])
+    assert ctl._precision_action(149,26,0,0,0,0) == 1
+    assert ctl._precision_debug[7]
+    assert .025 < ctl._precision_debug[6] < .08
+
+
+def test_actual_level35_shaft_stays_on_geometric_centre_after_entry_commit():
+    ctl = _actual_mpc()
+    ctl.path = [(150,22),(150,134)]
+    ctl.hazards = [(131,39,141,129),(163,39,173,129)]
+    ctl._ref = [(150,70,0,12)] * 14
+    ctl._hist.extend([(9.8,145.924,60.337,0),(10,145.924,60.337,0)])
+    assert ctl._precision_action(145.924,60.337,0,10.043,0,.028) == 1
+    assert not ctl._precision_debug[7]
+    assert ctl._precision_debug[8]
+    assert ctl._precision_debug[2] == 4.0  # geometric centre correction, capped near the opposite wall
