From b15f87b370b29ceed4d1cbb5b15529548078805d Mon Sep 17 00:00:00 2001
From: azumag <azumag@users.noreply.github.com>
Date: Mon, 24 Aug 2026 17:49:37 +0000
Subject: [PATCH] fix(analyze_board): move reactive_pairs scan out of
 type_count loop
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

calc_reactor_state の反応可能ペア走査 (O(n^2)) が type_count ループの
内側にインデントされており、盤面 n 駒に対して n 回再実行されていた。
ブロックは外側ループ変数 p を参照せず毎回 reactive_pairs/near_pairs を
再初期化するため、最終結果は1回実行と同一。1段デデントして1回だけ
実行する（挙動不変）。

検証: 実盤面fixture 8件 + ランダム盤面54件 + 縮退2件の計64ケースで
修正前後の calc_reactor_state 出力完全一致。n=40 で 4.05ms→0.26ms
(約16倍)。test_escape_mechanisms は前後で失敗集合が同一（既存のみ）、
test_post_russia_contact 22/22 OK、focus lane テストも前後同一。

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01UMTNFycBkeyvYUoonwHVVs
---
 analyze_board.py | 38 +++++++++++++++++++-------------------
 1 file changed, 19 insertions(+), 19 deletions(-)

diff --git a/analyze_board.py b/analyze_board.py
index c431d62..dbb258c 100755
--- a/analyze_board.py
+++ b/analyze_board.py
@@ -345,25 +345,25 @@ def calc_reactor_state(pieces, shapes=None):
     for p in pieces:
         type_count[p["type"]] = type_count.get(p["type"], 0) + 1
 
-        # 反応可能ペア数（同typeで接触圏内 ×1.5）
-        reactive_pairs = []
-        near_pairs = []
-        for i, p1 in enumerate(pieces):
-            for p2 in pieces[i + 1 :]:
-                if p1["type"] != p2["type"]:
-                    continue
-                dist = math.sqrt((p1["x"] - p2["x"]) ** 2 + (p1["y"] - p2["y"]) ** 2)
-                contact_r = p1["r"] + p2["r"]
-                if dist < contact_r * 1.1:
-                    reactive_pairs.append((p1["id"], p2["id"], p1["type"]))
-                elif dist < contact_r * 2.0:
-                    # 間に別タイプのピースが挟まっている場合は除外
-                    if not has_horizontal_obstruction(
-                        p1["x"], p1["y"], p1["r"], p2, pieces
-                    ):
-                        near_pairs.append(
-                            (p1["id"], p2["id"], p1["type"], round(dist - contact_r, 2))
-                        )
+    # 反応可能ペア数（同typeで接触圏内 ×1.5）
+    reactive_pairs = []
+    near_pairs = []
+    for i, p1 in enumerate(pieces):
+        for p2 in pieces[i + 1 :]:
+            if p1["type"] != p2["type"]:
+                continue
+            dist = math.sqrt((p1["x"] - p2["x"]) ** 2 + (p1["y"] - p2["y"]) ** 2)
+            contact_r = p1["r"] + p2["r"]
+            if dist < contact_r * 1.1:
+                reactive_pairs.append((p1["id"], p2["id"], p1["type"]))
+            elif dist < contact_r * 2.0:
+                # 間に別タイプのピースが挟まっている場合は除外
+                if not has_horizontal_obstruction(
+                    p1["x"], p1["y"], p1["r"], p2, pieces
+                ):
+                    near_pairs.append(
+                        (p1["id"], p2["id"], p1["type"], round(dist - contact_r, 2))
+                    )
 
     # パイプライン健全性: 連続するtype間の距離
     types_present = sorted(type_count.keys())
-- 
2.43.0

