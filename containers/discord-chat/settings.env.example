# Save outside the repository; contains paths/settings only, never secret values.
DOCICH_DISCORD_ENABLED=0
DOCICH_ALLOW_REAL_AI=0
DOCICH_DISCORD_GUILD_ID=
DOCICH_DISCORD_CHANNEL_IDS=
DOCICH_DISCORD_LLM_BASE_URL=
DOCICH_DISCORD_LLM_MODEL=
DOCICH_DISCORD_ALLOW_HTTP=0
DOCICH_DISCORD_TOKEN_SECRET_PATH=/absolute/private/discord-token
# Optional, only with compose.discord-chat-api-key.yml:
# DOCICH_DISCORD_LLM_API_KEY_SECRET_PATH=/absolute/private/llm-api-key
DOCICH_DISCORD_IMAGE=docich-discord-chat:local
