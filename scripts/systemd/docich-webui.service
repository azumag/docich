[Unit]
Description=docich webui (model chain / backoff manager)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=__DOCICH_ROOT__
ExecStart=__DOCICH_ROOT__/bin/docich webui
EnvironmentFile=-%h/.config/docich/webui.env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target