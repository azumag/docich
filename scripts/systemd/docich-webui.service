[Unit]
Description=docich webui (model chain / backoff manager)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=__DOCICH_ROOT__
# 本番 profile を明示する。既定の config/docich.toml は state_dir=run で、
# Corners タブが本番の run-soren-live ではなく空の state を表示してしまう。
ExecStart=__DOCICH_ROOT__/bin/docich --config __DOCICH_ROOT__/config/docich.soren-live.toml webui
EnvironmentFile=-%h/.config/docich/webui.env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target