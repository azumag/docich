[Unit]
Description=docich read-only OANDA practice FX market-data collector
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=__DOCICH_ROOT__
Environment=PYTHONPATH=__DOCICH_ROOT__/src
# Mandatory operator-managed credential file outside repository/GitHub.
EnvironmentFile=%h/.config/docich/oanda-practice.env
ExecStartPre=/usr/bin/bash __DOCICH_ROOT__/ops/vm_actions/check_oanda_practice_env.sh
ExecStartPre=/usr/bin/touch %t/docich-oanda-practice-start.marker
ExecStart=__DOCICH_ROOT__/.venv-trading/bin/python3 -m docich.trading.markets.oanda_market_data worker --config __DOCICH_ROOT__/config/docich.soren-live.toml --symbols USD_JPY,EUR_JPY --interval 5
ExecStartPost=__DOCICH_ROOT__/.venv-trading/bin/python3 __DOCICH_ROOT__/ops/vm_actions/wait_oanda_practice_ready.py --root __DOCICH_ROOT__ --config __DOCICH_ROOT__/config/docich.soren-live.toml --marker %t/docich-oanda-practice-start.marker --timeout 30
Restart=on-failure
RestartSec=15
TimeoutStartSec=40
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
