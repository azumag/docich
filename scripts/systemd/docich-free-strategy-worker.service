[Unit]
Description=docich isolated free-strategy PAPER worker
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=simple
User=ubuntu
SupplementaryGroups=docker
WorkingDirectory=__DOCICH_ROOT__
Environment=PATH=__DOCICH_ROOT__/.venv-trading/bin:/usr/local/bin:/usr/bin:/bin
# Intentionally required (no leading '-'): installing/enabling this unit without
# an explicit local PAPER configuration must fail before starting the worker.
EnvironmentFile=/home/ubuntu/.config/docich/free-strategy-worker.env
ExecStart=__DOCICH_ROOT__/bin/docich free-strategy-worker --trading-dir ${DOCICH_FREE_STRATEGY_TRADING_DIR} --image ${DOCICH_FREE_STRATEGY_IMAGE} --interval ${DOCICH_FREE_STRATEGY_INTERVAL} --enabled
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
# Host-side limits apply only to this new worker; the existing PAPER unit is
# intentionally not changed.  The worker also verifies the effective cgroup
# before it constructs a gateway or starts a PAPER cycle.
CPUQuota=100%
MemoryMax=1G
TasksMax=128

[Install]
WantedBy=multi-user.target
