[Unit]
Description=docich 全corner rolling rotation 判定
After=network.target

[Service]
Type=oneshot
WorkingDirectory=__DOCICH_ROOT__
# 時刻外tickは完全no-op。live runtime準備は開始/期限切れ復旧が必要な時だけ
# corner_rotation.py が既存 `docich up` 契約を通して実行する。
# メリケンの接続情報は共通unitへEnvironmentFileで継承せず、adapterが
# /home/ubuntu/soren/soren91-macos-agent.env のallowlistを実行時だけ読む。
ExecStart=__DOCICH_ROOT__/bin/docich --config __DOCICH_ROOT__/config/docich.soren-live.toml corner-rotation tick
TimeoutStartSec=infinity
