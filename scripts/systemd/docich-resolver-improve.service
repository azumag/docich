[Unit]
Description=docich resolver improve (リゾルバ戦略の定期改善・トークン不要)
After=default.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=__DOCICH_ROOT__
Environment=PYTHONPATH=__DOCICH_ROOT__/src
ExecStart=/usr/bin/python3 -m docich.resolver.improve robots --config __DOCICH_ROOT__/config/docich.soren-live.toml --daemon --cycle-min 120 --matches 3 --candidates 4
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
