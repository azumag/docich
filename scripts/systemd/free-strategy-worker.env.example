# Copy to ~/.config/docich/free-strategy-worker.env only after the production
# VM has passed the Docker/runsc capability check and the reviewed guest image
# has been built locally on that VM.
#
# PAPER only. No exchange credentials or live-order settings belong here.
DOCICH_FREE_STRATEGY_TRADING_DIR=/absolute/path/to/docich/run-soren-live/trading
DOCICH_FREE_STRATEGY_IMAGE=sha256:REPLACE_WITH_64_HEX_IMAGE_ID
DOCICH_FREE_STRATEGY_INTERVAL=300
