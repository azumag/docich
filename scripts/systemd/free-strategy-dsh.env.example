# Copy to ~/.config/docich/free-strategy-dsh.env (chmod 600). Never commit the real file.
# Disabled by default: the DSH path runs only when
# DOCICH_FREE_STRATEGY_GENERATOR=dsh (set by the unit) and this flag is 1.
DOCICH_FREE_STRATEGY_DSH_ENABLED=0
# Dedicated dir used as the DSH child's HOME. Absolute, existing, mode 0700. It holds
# only the DSH profile/credentials store and the npm cache; never point it at a dir
# that contains docich env files (~/.config/docich/*.env).
DOCICH_FREE_STRATEGY_DSH_HOME=/home/ubuntu/.local/share/docich-dsh
# OPENCODE_API_KEY=<owner-managed provider key; set it locally, never in Git>
